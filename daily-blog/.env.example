# 复制为 .env 后按需修改；.env 不提交到版本库
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/blog.db
LOG_LEVEL=info

SITE_TITLE=每日迭代博客
SITE_DESCRIPTION=以每日迭代方式构建的个人博客
SITE_AUTHOR=admin
SITE_PAGE_SIZE=10
# 一篇文章最多可设置的标签数（1-50）
SITE_MAX_TAGS_PER_POST=8
# 搜索关键词长度上限（8-200），超出返回 400
SITE_SEARCH_MAX_LENGTH=64
# 站点对外地址（canonical / RSS / sitemap 用），留空则按请求地址推断。
# 部署在反向代理后面时必须显式填写，否则生成的是容器内部地址。
SITE_BASE_URL=http://127.0.0.1:3000
# RSS 输出的已发布文章条数（1-100）
SITE_FEED_SIZE=20
# RSS 正文输出方式：summary 只输出摘要，full 输出渲染后的全文
SITE_FEED_MODE=summary
# 全站禁止搜索引擎收录（输出 noindex 与 robots.txt 的 Disallow: /）
SITE_ROBOTS_NOINDEX=false

# 评论（Day 5）
# 评论正文长度下限（1-100）
COMMENT_MIN_LENGTH=2
# 评论正文长度上限（20-5000）
COMMENT_MAX_LENGTH=1000
# 同一来源在窗口期内的提交条数上限（1-50），超出返回 429
COMMENT_RATE_LIMIT=3
# 频率限制窗口（1-1440 分钟）
COMMENT_RATE_WINDOW_MINUTES=10
# 单条评论允许携带的外链数量（0-10），超出返回 400
COMMENT_MAX_LINKS=3

# 后台管理员（Day 2）：启动时按这里的取值创建或同步管理员账号。
# 未设置 ADMIN_PASSWORD 时后台登录整体关闭；生产环境必须设置且不能沿用下面的占位值。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 登录会话
SESSION_COOKIE_NAME=daily_blog_admin
SESSION_TTL_HOURS=12
# 生产环境默认 true（必须 HTTPS 才发送 Cookie），本地 HTTP 调试可设为 false
SESSION_COOKIE_SECURE=false

# 交付加固（Day 7）
# 全局限流：同一来源在窗口内的请求数上限。默认额度故意留宽，
# 拦的是脚本扫站，不是正常浏览；真实部署在反向代理后面时请先确认 req.ip 取到的是客户端地址。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# 登录是「猜中即通关」的入口，额度单独给、单独收紧（且登录成功会清零）
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_MINUTES=10
# 安全响应头总开关（nosniff / X-Frame-Options / CSP / Referrer-Policy 等）
SECURITY_HEADERS_ENABLED=true
# HSTS 的 max-age（秒）。0 = 不发送；只有确认走 HTTPS 时才建议设置，
# 一旦被浏览器记住，短期内无法再用 http 访问本站。
SECURITY_HSTS_MAX_AGE=0
# CSRF 防护总开关。默认开启；自动化测试可以关掉，避免每个写请求都要先取表单令牌。
CSRF_ENABLED=true
CSRF_COOKIE_NAME=daily_blog_csrf
# 备份产物目录与保留份数（超出会删掉最旧的）
BACKUP_DIR=./backups
BACKUP_KEEP=10
