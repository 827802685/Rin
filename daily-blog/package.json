{
  "name": "daily-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "每日迭代开发的博客项目（Node.js + Express + SQLite + EJS）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
