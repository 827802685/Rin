<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__title" href="/"><%= site.title %></a>
    <nav class="site-header__nav">
      <a href="/">首页</a>
      <a href="/categories">分类</a>
      <a href="/tags">标签</a>
      <a href="/archive">归档</a>
      <a href="/search">搜索</a>
      <a href="/health">健康检查</a>
      <% if (typeof currentAdmin !== "undefined" && currentAdmin) { %>
        <a href="/admin">后台管理</a>
        <form class="nav-inline-form" method="post" action="/admin/logout">
          <%- include("../partials/csrf-field.ejs") %>
          <button class="link-button" type="submit" title="退出登录">
            退出（<%= currentAdmin.username %>）
          </button>
        </form>
      <% } else { %>
        <a href="/admin/login">登录</a>
      <% } %>
    </nav>
  </div>
</header>
