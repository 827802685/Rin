<section class="admin-head">
  <div>
    <h1 class="admin-head__title">站点配置</h1>
    <p class="page-intro__meta">
      这里的取值会覆盖环境变量，保存后立即生效，无需重启；留空的项回落到环境变量。
    </p>
  </div>
  <a class="link-muted" href="/admin">← 返回后台列表</a>
</section>

<% if (flash) { %>
  <p class="alert alert--info"><%= flash %></p>
<% } %>
<% if (notice) { %>
  <p class="alert alert--error"><%= notice %></p>
<% } %>

<form class="form settings-form" method="post" action="/admin/settings">
  <%- include("../../partials/csrf-field.ejs") %>
  <fieldset class="settings-group">
    <legend class="settings-group__legend">站点身份</legend>

    <label class="field <%= errors.siteTitle ? 'field--invalid' : '' %>">
      <span class="field__label">站点标题 *</span>
      <input class="field__input" type="text" name="siteTitle" maxlength="80" required
             value="<%= values.siteTitle %>" />
      <% if (errors.siteTitle) { %><span class="field__error"><%= errors.siteTitle %></span><% } %>
    </label>

    <label class="field <%= errors.siteDescription ? 'field--invalid' : '' %>">
      <span class="field__label">站点描述</span>
      <textarea class="field__input settings-form__textarea" name="siteDescription" rows="3" maxlength="200"><%= values.siteDescription %></textarea>
      <span class="field__hint">用于首页 description、RSS 描述与分享卡片。</span>
      <% if (errors.siteDescription) { %><span class="field__error"><%= errors.siteDescription %></span><% } %>
    </label>

    <label class="field <%= errors.siteAuthor ? 'field--invalid' : '' %>">
      <span class="field__label">默认作者</span>
      <input class="field__input" type="text" name="siteAuthor" maxlength="40"
             value="<%= values.siteAuthor %>" />
      <span class="field__hint">新建文章时预填的作者名。</span>
      <% if (errors.siteAuthor) { %><span class="field__error"><%= errors.siteAuthor %></span><% } %>
    </label>
  </fieldset>

  <fieldset class="settings-group">
    <legend class="settings-group__legend">地址与 SEO</legend>

    <label class="field <%= errors.siteUrl ? 'field--invalid' : '' %>">
      <span class="field__label">站点地址</span>
      <input class="field__input" type="url" name="siteUrl" maxlength="200"
             placeholder="https://example.com"
             value="<%= values.siteUrl %>" />
      <span class="field__hint">
        canonical、RSS 与站点地图必须使用绝对地址。留空时按请求地址推断；
        部署在反向代理后面时请显式填写，否则生成的是容器内部地址。
      </span>
      <% if (errors.siteUrl) { %><span class="field__error"><%= errors.siteUrl %></span><% } %>
    </label>

    <label class="field field--checkbox">
      <input type="checkbox" name="robotsNoindex" value="on"
             <%= values.robotsNoindex ? "checked" : "" %> />
      <span class="field__label">禁止搜索引擎收录整站（输出 noindex 与 robots.txt 的 Disallow: /）</span>
    </label>

    <% if (errors.robotsNoindex) { %><span class="field__error"><%= errors.robotsNoindex %></span><% } %>
  </fieldset>

  <fieldset class="settings-group">
    <legend class="settings-group__legend">列表与订阅</legend>

    <div class="settings-form__row">
      <label class="field <%= errors.pageSize ? 'field--invalid' : '' %>">
        <span class="field__label">每页文章数 *</span>
        <input class="field__input" type="number" name="pageSize" min="1" max="100" required
               value="<%= values.pageSize %>" />
        <% if (errors.pageSize) { %><span class="field__error"><%= errors.pageSize %></span><% } %>
      </label>

      <label class="field <%= errors.feedSize ? 'field--invalid' : '' %>">
        <span class="field__label">RSS 输出条数 *</span>
        <input class="field__input" type="number" name="feedSize" min="1" max="100" required
               value="<%= values.feedSize %>" />
        <% if (errors.feedSize) { %><span class="field__error"><%= errors.feedSize %></span><% } %>
      </label>

      <label class="field <%= errors.feedMode ? 'field--invalid' : '' %>">
        <span class="field__label">RSS 正文 *</span>
        <select class="field__input" name="feedMode">
          <option value="summary" <%= values.feedMode === "summary" ? "selected" : "" %>>仅摘要</option>
          <option value="full" <%= values.feedMode === "full" ? "selected" : "" %>>全文</option>
        </select>
        <% if (errors.feedMode) { %><span class="field__error"><%= errors.feedMode %></span><% } %>
      </label>
    </div>

    <p class="field__hint">
      订阅地址 <a href="/feed.xml" target="_blank" rel="noopener">/feed.xml</a> ·
      站点地图 <a href="/sitemap.xml" target="_blank" rel="noopener">/sitemap.xml</a> ·
      <a href="/robots.txt" target="_blank" rel="noopener">/robots.txt</a>
    </p>
  </fieldset>

  <div class="form__actions">
    <button class="button" type="submit">保存配置</button>
  </div>
</form>

<form class="form settings-reset" method="post" action="/admin/settings/reset"
      data-confirm="确定恢复默认配置？将清空本站全部自定义配置，改用环境变量的取值。">
  <%- include("../../partials/csrf-field.ejs") %>
  <div class="form__actions">
    <button class="button button--ghost" type="submit">恢复默认配置</button>
    <span class="field__hint">当前有 <%= overriddenCount %> 项已被自定义。</span>
  </div>
</form>
