<section class="admin-head">
  <div>
    <h1 class="admin-head__title">评论审核</h1>
    <p class="page-intro__meta">
      共 <%= counts.total %> 条 · 待审 <%= counts.pending %> · 已通过 <%= counts.approved %> · 已拒绝 <%= counts.rejected %>
    </p>
  </div>
  <div class="admin-head__actions">
    <a class="link-muted" href="/admin">文章列表</a>
    <a class="link-muted" href="/admin/taxonomy">分类与标签</a>
  </div>
</section>

<% if (flash) { %>
  <p class="alert alert--<%= flashType %>"><%= flash %></p>
<% } %>

<nav class="filter-tabs">
  <a class="filter-tabs__item <%= statusFilter ? '' : 'is-active' %>" href="/admin/comments">全部</a>
  <a class="filter-tabs__item <%= statusFilter === 'pending' ? 'is-active' : '' %>" href="/admin/comments?status=pending">待审</a>
  <a class="filter-tabs__item <%= statusFilter === 'approved' ? 'is-active' : '' %>" href="/admin/comments?status=approved">已通过</a>
  <a class="filter-tabs__item <%= statusFilter === 'rejected' ? 'is-active' : '' %>" href="/admin/comments?status=rejected">已拒绝</a>
</nav>

<% if (items.length === 0) { %>
  <p class="empty-state">
    <% if (statusFilter === 'pending') { %>
      没有待审核的评论。
    <% } else { %>
      这里还没有评论。
    <% } %>
  </p>
<% } else { %>
  <ul class="comment-admin-list">
    <% items.forEach(function (comment) { %>
      <li class="comment-admin">
        <div class="comment-admin__main">
          <p class="comment-admin__meta">
            <strong><%= comment.authorName %></strong>
            <% if (comment.authorEmail) { %>
              <span class="comment-admin__email">&lt;<%= comment.authorEmail %>&gt;</span>
            <% } %>
            <% if (comment.authorUrl) { %>
              <a class="link-muted" href="<%= comment.authorUrl %>" target="_blank" rel="noopener noreferrer">网址</a>
            <% } %>
            <span>·</span>
            <span><%= comment.createdAt %></span>
            <span>·</span>
            <span class="badge badge--comment-<%= comment.status %>"><%= comment.statusLabel %></span>
          </p>
          <p class="comment-admin__content"><%= comment.content %></p>
          <p class="comment-admin__source">
            文章：<a href="<%= comment.post.url %>#comments" target="_blank" rel="noopener"><%= comment.post.title %></a>
            <% if (comment.post.status !== 'published') { %>
              <span class="badge badge--draft">该文章是草稿</span>
            <% } %>
            · 来源标识 <code><%= comment.ipHash.slice(0, 8) %></code>
            <% if (comment.moderatedAt) { %>
              · <%= comment.moderatedAt %> 由 <%= comment.moderator ? comment.moderator : '已注销账号' %> 处理
            <% } %>
          </p>
        </div>
        <div class="comment-admin__actions">
          <% if (comment.status !== 'approved') { %>
            <form method="post" action="/admin/comments/<%= comment.id %>/status">
              <%- include("../../partials/csrf-field.ejs") %>
              <input type="hidden" name="status" value="approved" />
              <% if (statusFilter) { %><input type="hidden" name="filter" value="<%= statusFilter %>" /><% } %>
              <button class="link-button" type="submit">通过</button>
            </form>
          <% } %>
          <% if (comment.status !== 'rejected') { %>
            <form method="post" action="/admin/comments/<%= comment.id %>/status">
              <%- include("../../partials/csrf-field.ejs") %>
              <input type="hidden" name="status" value="rejected" />
              <% if (statusFilter) { %><input type="hidden" name="filter" value="<%= statusFilter %>" /><% } %>
              <button class="link-button" type="submit">拒绝</button>
            </form>
          <% } %>
          <form
            method="post"
            action="/admin/comments/<%= comment.id %>/delete"
            data-confirm="确定删除这条评论？该操作不可撤销。"
          >
            <%- include("../../partials/csrf-field.ejs") %>
            <% if (statusFilter) { %><input type="hidden" name="filter" value="<%= statusFilter %>" /><% } %>
            <button class="link-button link-button--danger" type="submit">删除</button>
          </form>
        </div>
      </li>
    <% }); %>
  </ul>

  <nav class="pagination">
    <% if (pagination.hasPrev) { %>
      <a class="pagination__link" href="/admin/comments?page=<%= pagination.page - 1 %><%= statusFilter ? '&status=' + statusFilter : '' %>">上一页</a>
    <% } %>
    <span class="pagination__current">第 <%= pagination.page %> / <%= pagination.totalPages %> 页</span>
    <% if (pagination.hasNext) { %>
      <a class="pagination__link" href="/admin/comments?page=<%= pagination.page + 1 %><%= statusFilter ? '&status=' + statusFilter : '' %>">下一页</a>
    <% } %>
  </nav>
<% } %>
