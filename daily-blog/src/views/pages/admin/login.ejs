<section class="admin-auth">
  <h1 class="admin-auth__title">后台登录</h1>
  <p class="admin-auth__hint">登录后可新建、编辑文章并切换草稿与发布状态。</p>

  <% if (!adminEnabled) { %>
    <p class="alert alert--warn">
      后台登录尚未启用：请在 <code>daily-blog/.env</code> 中设置 <code>ADMIN_PASSWORD</code> 后重启服务。
    </p>
  <% } %>

  <% if (error) { %>
    <p class="alert alert--error"><%= error %></p>
  <% } %>

  <form class="form" method="post" action="/admin/login">
    <input type="hidden" name="next" value="<%= next %>" />

    <label class="field">
      <span class="field__label">用户名</span>
      <input
        class="field__input"
        type="text"
        name="username"
        value="<%= username %>"
        autocomplete="username"
        autofocus
        required
      />
    </label>

    <label class="field">
      <span class="field__label">密码</span>
      <input
        class="field__input"
        type="password"
        name="password"
        autocomplete="current-password"
        required
      />
    </label>

    <div class="form__actions">
      <button class="button" type="submit">登录</button>
      <a class="link-muted" href="/">返回首页</a>
    </div>
  </form>
</section>
