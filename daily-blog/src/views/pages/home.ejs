<section class="page-intro">
  <h1>最新文章</h1>
  <p class="page-intro__meta">共 <%= pagination.total %> 篇</p>
</section>

<% if (posts.length === 0) { %>
  <p class="empty-state">还没有已发布的文章，先运行 <code>npm run seed</code> 写入示例数据。</p>
<% } else { %>
  <ul class="post-list">
    <% posts.forEach(function (post) { %>
      <li class="post-card">
        <h2 class="post-card__title">
          <a href="/posts/<%= post.slug %>"><%= post.title %></a>
        </h2>
        <p class="post-card__meta">
          <span><%= post.publishedAt %></span>
          <span>·</span>
          <span><%= post.author %></span>
          <span>·</span>
          <span>约 <%= post.readingMinutes %> 分钟</span>
        </p>
        <p class="post-card__summary"><%= post.summary %></p>
      </li>
    <% }); %>
  </ul>

  <nav class="pagination">
    <% if (pagination.hasPrev) { %>
      <a class="pagination__link" href="/?page=<%= pagination.page - 1 %>">上一页</a>
    <% } %>
    <span class="pagination__current">第 <%= pagination.page %> / <%= pagination.totalPages %> 页</span>
    <% if (pagination.hasNext) { %>
      <a class="pagination__link" href="/?page=<%= pagination.page + 1 %>">下一页</a>
    <% } %>
  </nav>
<% } %>
